{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "lib": ["ES2022"],
    "strict": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true, "resolveJsonModule": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": "src", "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
