{
  "name": "code-boy",
  "displayName": "Code Boy",
  "description": "Your cozy pixel-art programmer companion in VS Code. Types as you code, vibes to your music, levels up, and keeps you in flow.",
  "version": "1.0.10",
  "publisher": "code-boy-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbetikDev/Code-Boy.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pixel",
    "pet",
    "tamagotchi",
    "companion",
    "vibe"
  ],
  "icon": "assets/icons/extension.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:codeBoy.companion",
    "onView:contextback.sidebar"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeboy",
          "title": "Code Boy",
          "icon": "assets/icons/activity.svg"
        }
      ]
    },
    "views": {
      "codeboy": [
        {
          "id": "codeBoy.companion",
          "name": "Code Boy",
          "type": "webview",
          "when": "codeBoy.screen != context"
        },
        {
          "id": "contextback.sidebar",
          "name": "ContextBack",
          "type": "webview",
          "when": "codeBoy.screen == context"
        }
      ]
    },
    "commands": [
      {
        "command": "codeBoy.open",
        "title": "Open",
        "category": "Code Boy"
      },
      {
        "command": "contextBack.openSidebar",
        "title": "Open in Code Boy Sidebar",
        "category": "ContextBack"
      },
      {
        "command": "codeBoy.resolveBlockerWithBob",
        "title": "Resolve Blocker with Bob",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.resumeSession",
        "title": "Resume Session",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.pet",
        "title": "Pet",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.dance",
        "title": "Dance",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.toggleVibeMode",
        "title": "Toggle Vibe Mode",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.sleep",
        "title": "Sleep",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.wakeUp",
        "title": "Wake Up",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.changeRoom",
        "title": "Change Room",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.showStats",
        "title": "Show Stats",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.toggleMusicDetection",
        "title": "Toggle Music Detection",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.resetCharacter",
        "title": "Reset Character",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.connectSpotify",
        "title": "Connect Spotify Access Token",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.disconnectSpotify",
        "title": "Disconnect Spotify",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.spriteGallery",
        "title": "Sprite Gallery",
        "category": "Code Boy",
        "enablement": "codeBoy.development"
      },
      {
        "command": "codeBoy.toggleFloatingMascot",
        "title": "Toggle Floating Mascot",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.enableFloatingOverlay",
        "title": "Enable Floating Mascot (Включить плавающего персонажа)",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.disableFloatingOverlay",
        "title": "Disable Floating Mascot (Отключить плавающего персонажа)",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.toggleFloatingOverlay",
        "title": "Toggle Floating Mascot (Показать/Скрыть плавающего персонажа)",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.resetFloatingPosition",
        "title": "Reset Mascot Position (Вернуть персонажа в правый нижний угол)",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.showFloatingOverlay",
        "title": "Show Floating Mascot (Показать плавающего персонажа)",
        "category": "Code Boy"
      },
      {
        "command": "codeBoy.hideFloatingOverlay",
        "title": "Hide Floating Mascot (Скрыть плавающего персонажа)",
        "category": "Code Boy"
      },
      {
        "command": "contextBack.openDashboard",
        "title": "Open Dashboard",
        "category": "ContextBack"
      },
      {
        "command": "contextBack.continueSession",
        "title": "Continue Last Session",
        "category": "ContextBack"
      },
      {
        "command": "contextBack.summarizeSession",
        "title": "Summarize Last Session",
        "category": "ContextBack"
      },
      {
        "command": "contextBack.showOpenThreads",
        "title": "Show Open Threads",
        "category": "ContextBack"
      },
      {
        "command": "contextBack.pauseTracking",
        "title": "Pause Tracking",
        "category": "ContextBack"
      },
      {
        "command": "contextBack.clearHistory",
        "title": "Clear Project History",
        "category": "ContextBack"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codeBoy.spriteGallery",
          "when": "codeBoy.development"
        }
      ]
    },
    "configuration": [
      {
        "title": "Code Boy",
        "properties": {
          "codeBoy.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the companion and local activity tracking."
          },
          "codeBoy.soundEnabled": {
            "type": "boolean",
            "default": false,
            "description": "Play quiet, short pixel sounds after interacting with the companion."
          },
          "codeBoy.musicDetection": {
            "type": "boolean",
            "default": true,
            "description": "Check local Windows media playback (SMTC), or Spotify when you explicitly connect it. Never records audio."
          },
          "codeBoy.animations": {
            "type": "boolean",
            "default": true,
            "description": "Animate the character and room."
          },
          "codeBoy.reactions": {
            "type": "boolean",
            "default": true,
            "description": "React to saves, tasks, and editor activity."
          },
          "codeBoy.idleAnimations": {
            "type": "boolean",
            "default": true,
            "description": "Play occasional idle variations and random events."
          },
          "codeBoy.showDiagnosticsReaction": {
            "type": "boolean",
            "default": true,
            "description": "React to changes in the local error count."
          },
          "codeBoy.vibeMode": {
            "type": "boolean",
            "default": false,
            "description": "Put on headphones and enter vibe coding mode."
          },
          "codeBoy.roomTheme": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "NIGHT",
              "CYBER",
              "FOREST",
              "SPACE",
              "RETRO_PC"
            ],
            "default": "DEFAULT",
            "description": "Preferred room. Cosmetic themes become available as Code Boy levels up."
          },
          "codeBoy.animationSpeed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.5,
            "default": 1,
            "description": "Sprite playback speed; capped at 12 FPS."
          },
          "codeBoy.reducedMotion": {
            "type": "boolean",
            "default": false,
            "description": "Use still poses and disable ambient effects. System reduced-motion preferences are also respected."
          },
          "codeBoy.floatingOverlay": {
            "type": "boolean",
            "default": false,
            "description": "Show the floating Code Boy after explicitly enabling its workbench overlay."
          }
        }
      },
      {
        "title": "ContextBack",
        "properties": {
          "contextBack.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable ContextBack session tracking."
          },
          "contextBack.sessionTimeoutMinutes": {
            "type": "number",
            "default": 20,
            "enum": [5, 10, 20, 30, 60],
            "description": "Minutes of inactivity before a session ends automatically."
          },
          "contextBack.welcomeBackAfterHours": {
            "type": "number",
            "default": 8,
            "enum": [4, 8, 12, 24, 48, 168],
            "description": "Show the Welcome Back card if the last session ended this many hours ago."
          },
          "contextBack.trackTerminalCommands": {
            "type": "boolean",
            "default": true,
            "description": "Record terminal command names and exit codes (never outputs)."
          },
          "contextBack.trackDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Track TypeScript / ESLint errors and warnings."
          },
          "contextBack.trackGit": {
            "type": "boolean",
            "default": true,
            "description": "Poll git for branch, commits, and changed files."
          },
          "contextBack.trackTodos": {
            "type": "boolean",
            "default": true,
            "description": "Scan saved files for TODO / FIXME / HACK / XXX comments."
          },
          "contextBack.ai.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Use IBM Bob Shell for session summaries. Requires an installed and authenticated bob command; session metadata is sent to Bob."
          },
          "contextBack.ai.provider": {
            "type": "string",
            "enum": ["disabled", "bob"],
            "default": "bob",
            "description": "Session summary provider. Bob Shell is called only when IBM Bob summaries are enabled."
          },
          "contextBack.exclude": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["**/.env*", "**/secrets/**", "**/credentials/**", "**/*.pem", "**/*.key"],
            "description": "Glob patterns for files that ContextBack will never record."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "npm run check && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "test": "tsc -p tsconfig.test.json && node --test .test/test/*.test.js",
    "test:host": "npm run compile && tsc -p tsconfig.test.json && node scripts/test-host.cjs",
    "test:webview": "npm run compile && playwright test",
    "preview": "npm run compile && node scripts/preview.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --readme-path README.vscode.md --allow-missing-repository --no-dependencies --out code-boy-1.0.10.vsix"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
